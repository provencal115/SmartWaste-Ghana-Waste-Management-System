{
    "name": "smartwaste/ghana",
    "description": "Smart Garbage Collection & Inventory Management System",
    "require": {
        "php": ">=8.0",
        "dompdf/dompdf": "^2.0",
        "phpmailer/phpmailer": "^6.9"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "allow-plugins": {
            "*": true
        },
        "policy": {
            "advisories": {
                "block": false
            }
        }
    }
}
